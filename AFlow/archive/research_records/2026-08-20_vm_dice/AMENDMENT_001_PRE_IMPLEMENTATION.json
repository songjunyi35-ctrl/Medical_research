  "loss_contract": {
    "arm_names": ["paper_dice_gamma0", "vm_dice_gamma1"],
    "gamma0_modulation": "explicit torch.ones_like(probability), avoiding implicit 0**0 semantics",
    "gamma1_modulation": "abs(target-probability.detach())",
    "probability_path": "sigmoid(raw_logit.float()) remains attached in numerator and denominator",
    "class_order": ["background", "foreground"],
    "present_class_rule": "within each volume average only classes with at least one positive GT voxel; background is expected present",
    "epsilon": 1e-6,
    "dice_denominator": "sum modulation*(target.square()+probability.square())",
    "ce": "0.1 times mean BCEWithLogits on the original one-channel foreground raw logit",
    "total_reduction": "per-volume present-class mean then batch mean; add scalar CE",
    "no_teacher": true
  },
  "optimizer_and_runtime": {
    "single_parameter_group": "plain student parameters only",
    "adamw": {"lr": 1e-5, "weight_decay": 1e-5, "betas": [0.9, 0.999], "eps": 1e-8, "amsgrad": false, "foreach": false, "fused": false},
    "zero_grad_set_to_none": true,
    "clip_grad_norm": 5.0,
    "clip_error_if_nonfinite": true,
    "formal_peak_memory_must_be_at_most_24gib": true,
    "formal_status_must_fail_if_memory_or_pairing_gate_fails": true
  },
